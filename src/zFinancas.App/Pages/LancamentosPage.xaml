<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:zFinancas.App.ViewModels"
             x:Class="zFinancas.App.Pages.LancamentosPage"
             x:DataType="vm:LancamentosViewModel"
             Title=""
             Background="{StaticResource GradienteFundo}">

  <Grid RowDefinitions="Auto,*" Padding="24,16,24,0" RowSpacing="14" MaximumWidthRequest="1180">

    <!-- ============ cabeçalho e filtros -->
    <VerticalStackLayout Grid.Row="0" Spacing="12">

      <Grid ColumnDefinitions="*">
        <Label Text="Lançamentos"
                       Style="{StaticResource TituloPagina}"
                       FontSize="{OnIdiom Phone=24, Desktop=30}"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Entry Text="{Binding Busca}" Placeholder="Buscar por descrição…" />

        <Button Grid.Column="1"
                        Text="{Binding ResumoContas}"
                        Command="{Binding AbrirSelecaoContasCommand}"
                        Style="{StaticResource BotaoSecundario}"
                        Padding="12,10" />
      </Grid>

      <!-- filtro + data de corte (a lista começa aqui; dá para voltar quando entrar parcela antiga) -->
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">

        <VerticalStackLayout Spacing="1" HorizontalOptions="End" VerticalOptions="End">
          <Label Text="A partir de" Style="{StaticResource Rotulo}" VerticalOptions="Center" HorizontalOptions="Center" />
          <DatePicker Date="{Binding DataCorte}" Format="dd/MM/yyyy" />
        </VerticalStackLayout>

        <Grid Grid.Column="1" ColumnSpacing="10">
          <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="End">
            <Label Text="Só pendentes" Style="{StaticResource Rotulo}" VerticalOptions="Center" HorizontalTextAlignment="Start"  TextColor="#F7B955" />
            <Switch Grid.Column="1" IsToggled="{Binding SomentePendentes}" VerticalOptions="Center" Margin="20,0,0,0" />
          </VerticalStackLayout>
        </Grid>

        <Button Grid.Column="2"
                Text="+  Novo"
                Command="{Binding NovoCommand}"
                HorizontalOptions="End"
                VerticalOptions="Center" />
      </Grid>
      <Border Style="{StaticResource Campo}">
        <VerticalStackLayout Spacing="1" HorizontalOptions="End" VerticalOptions="End">
          <Label Text="SALDO ANTERIOR" Style="{StaticResource Rotulo}" />
          <Label Text="{Binding SaldoAnteriorTexto}"
                            FontFamily="OpenSansSemibold"
                            FontSize="18"
                            TextColor="{StaticResource Texto}" />
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>

    <!-- ============ lista -->
    <CollectionView Grid.Row="1"
                    ItemsSource="{Binding Itens}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Never"
                    Margin="0,0,0,16">
      <CollectionView.EmptyView>
        <Border Style="{StaticResource Card}">
          <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
            <Label Text="🧾" FontSize="26" HorizontalOptions="Center" />
            <Label Text="Nenhum lançamento encontrado" Style="{StaticResource TituloSecao}" HorizontalTextAlignment="Center" />
            <Label Text="Ajuste os filtros ou registre um novo lançamento." Style="{StaticResource Subtitulo}" HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </Border>
      </CollectionView.EmptyView>

      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="vm:LancamentoVm">
          <Border Style="{StaticResource LinhaLista}"
                            Margin="0,0,0,8"
                            BackgroundColor="{Binding CorFundoDestaque}">
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LancamentosViewModel}}, Path=EditarCommand}"
                                    CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0" Padding="0">
              <Border WidthRequest="56"
                      HeightRequest="56"
                      BackgroundColor="{StaticResource SuperficieElevada}"
                      StrokeShape="RoundRectangle 8,0,8,0"
                      VerticalOptions="Center">
                <Label Text="{Binding IconeCentro}" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>

              <Grid Grid.Column="1" ColumnDefinitions="*">
                <VerticalStackLayout Spacing="1" VerticalOptions="End">
                  <Label Text="{Binding Descricao}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{Binding CorPendente}" />

                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="1" VerticalOptions="End">
                      <Label Text="{Binding Detalhe}" Style="{StaticResource Subtitulo}" FontSize="11" />
                      <Label Text="{Binding ContaDescricao}" FontSize="10" TextColor="{StaticResource TextoFraco}" />
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="End">
                      <Label Text="{Binding ValorTexto}"
                                         FontFamily="OpenSansSemibold"
                                         FontSize="14"
                                         TextColor="{Binding CorValor}"
                                         HorizontalTextAlignment="End" />
                      <Label Text="{Binding SaldoTexto}"
                                         FontSize="11"
                                         TextColor="{Binding CorSaldo}"
                                         IsVisible="{Binding TemSaldo}"
                                         HorizontalTextAlignment="End" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                                      Text="✓"
                                      FontSize="16"
                                      SemanticProperties.Description="Compensar"
                                      IsVisible="{Binding Pendente}"
                                      Style="{StaticResource BotaoTexto}"
                                      Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LancamentosViewModel}}, Path=CompensarCommand}"
                                      CommandParameter="{Binding .}"
                                      VerticalOptions="Center"
                                      HorizontalOptions="End" />

                    <Button Grid.Column="3"
                                      Text="⋯"
                                      FontSize="18"
                                      Style="{StaticResource BotaoTexto}"
                                      Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LancamentosViewModel}}, Path=AcoesCommand}"
                                      CommandParameter="{Binding .}"
                                      VerticalOptions="Center"
                                      HorizontalOptions="End" />
                  </Grid>
                </VerticalStackLayout>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <!-- carregando: aparece enquanto a lista é montada (volume grande no celular) -->
    <Grid Grid.Row="1"
          IsVisible="{Binding MostrarCarregando}"
          BackgroundColor="#D905080F">
      <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
        <ActivityIndicator IsRunning="{Binding MostrarCarregando}"
                           IsVisible="{Binding MostrarCarregando}"
                           Color="{StaticResource Primaria}"
                           HeightRequest="34"
                           WidthRequest="34" />
        <Label Text="Carregando lançamentos…" Style="{StaticResource Subtitulo}" />
      </VerticalStackLayout>
    </Grid>
    <!-- ===================== painel de seleção de parcelas ===================== -->
    <Grid Grid.RowSpan="2"
                              IsVisible="{Binding SelecaoAtiva}"
                              BackgroundColor="#CC05080F"
                              Padding="24">

      <Border Style="{StaticResource CardElevado}"
                                    Padding="0"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Fill"
                                    MaximumWidthRequest="720">

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

          <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="4">
            <Label Text="{Binding Selecao.Titulo}" Style="{StaticResource TituloSecao}" />
            <Label Text="{Binding Selecao.Instrucao}"
                                               Style="{StaticResource Subtitulo}"
                                               FontSize="11" />
          </VerticalStackLayout>

          <CollectionView Grid.Row="1"
                                                    ItemsSource="{Binding Selecao.Parcelas}"
                                                    SelectionMode="None"
                                                    MaximumHeightRequest="330"
                                                    Margin="20,0">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="vm:ParcelaSelecionavel">
                <Border BackgroundColor="{StaticResource Superficie}"
                                                        StrokeThickness="0"
                                                        Padding="12"
                                                        Margin="0,0,0,6"
                                                        StrokeShape="RoundRectangle 10">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding Selecionada, Mode=TwoWay}"
                                                                  VerticalOptions="Center"
                                                                  Color="{StaticResource Primaria}" />

                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                      <Label Text="{Binding Descricao}" FontSize="13" FontFamily="OpenSansSemibold" />
                      <Label Text="{Binding Detalhe}" Style="{StaticResource Subtitulo}" FontSize="10" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                                                               Text="{Binding ValorTexto}"
                                                               TextColor="{Binding CorValor}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="13"
                                                               VerticalOptions="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <VerticalStackLayout Grid.Row="2" Padding="20,10,20,18" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="10">
              <Button Text="Marcar todas"
                                                    Command="{Binding MarcarTodasSelecaoCommand}"
                                                    Style="{StaticResource BotaoTexto}" />

              <Button Grid.Column="1"
                                                    Text="Limpar"
                                                    Command="{Binding LimparSelecaoCommand}"
                                                    Style="{StaticResource BotaoTexto}" />

              <VerticalStackLayout Grid.Column="2" Spacing="0" HorizontalOptions="End">
                <Label Text="{Binding Selecao.QuantidadeTexto}"
                                                       Style="{StaticResource Rotulo}"
                                                       HorizontalOptions="End" />
                <Label Text="{Binding Selecao.TotalTexto}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="15"
                                                       HorizontalOptions="End" />
              </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Text="Cancelar"
                                                    Command="{Binding CancelarSelecaoCommand}"
                                                    Style="{StaticResource BotaoSecundario}" />

              <Button Grid.Column="1"
                                                    Text="{Binding Selecao.TextoConfirmar}"
                                                    Command="{Binding ConfirmarSelecaoCommand}"
                                                    IsEnabled="{Binding Selecao.TemSelecao}" />
            </Grid>
          </VerticalStackLayout>
        </Grid>
      </Border>
    </Grid>
    <!-- ===================== painel de seleção de contas ===================== -->
    <Grid Grid.RowSpan="2"
                  IsVisible="{Binding SelecaoContasAtiva}"
                  BackgroundColor="#CC05080F"
                  Padding="24">

      <Border Style="{StaticResource CardElevado}"
                        Padding="0"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        MaximumWidthRequest="560">

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

          <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="4">
            <Label Text="{Binding SelecaoContas.Titulo}" Style="{StaticResource TituloSecao}" />
            <Label Text="{Binding SelecaoContas.Instrucao}"
                                   Style="{StaticResource Subtitulo}"
                                   FontSize="11" />
          </VerticalStackLayout>

          <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding SelecaoContas.Contas}"
                                        SelectionMode="None"
                                        MaximumHeightRequest="320"
                                        Margin="20,0">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="vm:ContaFiltro">
                <Border BackgroundColor="{StaticResource Superficie}"
                                            StrokeThickness="0"
                                            Padding="12"
                                            Margin="0,0,0,6"
                                            StrokeShape="RoundRectangle 10">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding Selecionada, Mode=TwoWay}"
                                                      VerticalOptions="Center"
                                                      Color="{StaticResource Primaria}" />

                    <Label Grid.Column="1"
                                                   Text="{Binding Rotulo}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <VerticalStackLayout Grid.Row="2" Padding="20,10,20,18" Spacing="10">
            <HorizontalStackLayout Spacing="12">
              <Button Text="Marcar todas"
                                        Command="{Binding SelecaoContas.MarcarTodasCommand}"
                                        Style="{StaticResource BotaoTexto}" />

              <Button Text="Limpar"
                                        Command="{Binding SelecaoContas.LimparCommand}"
                                        Style="{StaticResource BotaoTexto}" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Text="Cancelar"
                                        Command="{Binding SelecaoContas.CancelarCommand}"
                                        Style="{StaticResource BotaoSecundario}" />

              <Button Grid.Column="1"
                                        Text="{Binding SelecaoContas.TextoConfirmar}"
                                        Command="{Binding SelecaoContas.ConfirmarCommand}"
                                        IsEnabled="{Binding SelecaoContas.TemSelecao}" />
            </Grid>
          </VerticalStackLayout>
        </Grid>
      </Border>
    </Grid>
    <!-- ===================== painel de compensação ===================== -->
    <Grid Grid.RowSpan="2"
                  IsVisible="{Binding CompensacaoAtiva}"
                  BackgroundColor="#CC05080F"
                  Padding="24">

      <Border Style="{StaticResource CardElevado}"
                        Padding="0"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        MaximumWidthRequest="470">

        <VerticalStackLayout Padding="22,20" Spacing="14">

          <VerticalStackLayout Spacing="2">
            <Label Text="Compensar lançamento" Style="{StaticResource TituloSecao}" />
            <Label Text="{Binding Compensacao.Descricao}"
                                   Style="{StaticResource Subtitulo}"
                                   FontSize="12" />
          </VerticalStackLayout>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="VALOR" Style="{StaticResource Rotulo}" VerticalOptions="Center" />
            <Label Grid.Column="1"
                                   Text="{Binding Compensacao.ValorTexto}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   VerticalOptions="Center" />
          </Grid>

          <VerticalStackLayout Spacing="6">
            <Label Text="DATA DA COMPENSAÇÃO" Style="{StaticResource Rotulo}" />

            <Border Style="{StaticResource Campo}">
              <DatePicker Date="{Binding Compensacao.Data}" Format="dd/MM/yyyy" />
            </Border>

            <Label Text="{Binding Compensacao.VencimentoTexto}"
                                   Style="{StaticResource Subtitulo}"
                                   FontSize="11" />
          </VerticalStackLayout>

          <HorizontalStackLayout Spacing="10">
            <Button Text="{Binding Compensacao.RotuloHoje}"
                                    Command="{Binding Compensacao.HojeCommand}"
                                    Style="{StaticResource BotaoTexto}"
                                    FontSize="11" />

            <Button Text="Usar o vencimento"
                                    Command="{Binding Compensacao.ManterVencimentoCommand}"
                                    Style="{StaticResource BotaoTexto}"
                                    FontSize="11" />
          </HorizontalStackLayout>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Cancelar"
                                    Command="{Binding Compensacao.CancelarCommand}"
                                    Style="{StaticResource BotaoSecundario}" />

            <Button Grid.Column="1"
                                    Text="Confirmar"
                                    Command="{Binding Compensacao.ConfirmarCommand}" />
          </Grid>
        </VerticalStackLayout>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
