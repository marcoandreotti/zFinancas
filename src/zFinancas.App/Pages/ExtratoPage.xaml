<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:zFinancas.App.ViewModels"
             x:Class="zFinancas.App.Pages.ExtratoPage"
             x:DataType="vm:ExtratoViewModel"
             Title=""
             Background="{StaticResource GradienteFundo}">

  <Grid RowDefinitions="Auto,Auto,*" Padding="24,16,24,0" RowSpacing="12" MaximumWidthRequest="1180">

    <!-- ============================ filtros -->
    <VerticalStackLayout Grid.Row="0" Spacing="12">
      <Grid ColumnDefinitions="*" ColumnSpacing="10">
        <Label Text="Extrato de lançamentos"
                       Style="{StaticResource TituloPagina}"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
      </Grid>

      <VerticalStackLayout Spacing="10">

        <Button Text="{Binding ResumoContas}"
                        Command="{Binding AbrirSelecaoContasCommand}"
                        Style="{StaticResource BotaoSecundario}"
                        HorizontalOptions="Fill"
                        LineBreakMode="TailTruncation" />

        <Grid ColumnDefinitions="*,Auto">
          <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10" HorizontalOptions="End">
            <Border Style="{StaticResource Campo}">
              <DatePicker Date="{Binding DataInicio}" Format="dd/MM/yyyy" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Campo}">
              <DatePicker Date="{Binding DataFim}" Format="dd/MM/yyyy" />
            </Border>

            <Border Grid.Column="2">
              <Button Text="Atualizar"
                      FontSize="13"
                      Padding="14,10"
                      Command="{Binding CarregarCommand}"
                      Style="{StaticResource BotaoSecundario}"
                      SemanticProperties.Description="Atualizar"
                      VerticalOptions="Center"
                      HorizontalOptions="End" />
            </Border>
          </Grid>
        </Grid>
        
      </VerticalStackLayout>

      <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="8">
          <Button Text="Últimos 4 dias + 2 meses" Command="{Binding Ultimos4DiasCommand}" Style="{StaticResource BotaoTexto}" />
          <Button Text="Últimos 2 meses" Command="{Binding Ultimos2MesesCommand}" Style="{StaticResource BotaoTexto}" />
          <Button Text="Mês passado" Command="{Binding MesPassadoCommand}" Style="{StaticResource BotaoTexto}" />
          <Button Text="Mês atual" Command="{Binding MesAtualCommand}" Style="{StaticResource BotaoTexto}" />
        </HorizontalStackLayout>
      </ScrollView>
    </VerticalStackLayout>

    <!-- ============================ resumo de saldos -->
    <Border Grid.Row="1" Style="{StaticResource CardElevado}">
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
        <VerticalStackLayout Spacing="2">
          <Label Text="SALDO ANTERIOR" Style="{StaticResource Rotulo}" />
          <Label Text="{Binding SaldoAnteriorTexto}" Style="{StaticResource ValorMedio}" FontSize="15" />
          <Label Text="só compensados" FontSize="9" TextColor="{StaticResource TextoFraco}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Column="1" Spacing="2">
          <Label Text="SALDO FINAL" Style="{StaticResource Rotulo}" />
          <Label Text="{Binding SaldoFinalTexto}" Style="{StaticResource ValorMedio}" FontSize="15" />
          <Label Text="projetado" FontSize="9" TextColor="{StaticResource TextoFraco}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="2">
          <Label Text="COMPENSADO" Style="{StaticResource Rotulo}" />
          <Label Text="{Binding SaldoCompensadoTexto}" Style="{StaticResource ValorPositivo}" FontSize="15" />
          <Label Text="ao fim do período" FontSize="9" TextColor="{StaticResource TextoFraco}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
          <Label Text="ENTRADAS / SAÍDAS" Style="{StaticResource Rotulo}" />
          <HorizontalStackLayout Spacing="6">
            <Label Text="{Binding EntradasTexto}" Style="{StaticResource ValorPositivo}" FontSize="13" />
            <Label Text="•" TextColor="{StaticResource TextoFraco}" FontSize="13" />
            <Label Text="{Binding SaidasTexto}" Style="{StaticResource ValorNegativo}" FontSize="13" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </Grid>
    </Border>

    <!-- ============================ linhas -->
    <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Itens}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        Margin="0,0,0,16">
      <CollectionView.EmptyView>
        <Border Style="{StaticResource Card}">
          <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
            <Label Text="📊" FontSize="24" HorizontalOptions="Center" />
            <Label Text="Nenhum lançamento no período" Style="{StaticResource TituloSecao}" HorizontalTextAlignment="Center" />
            <Label Text="Escolha outra conta ou ajuste as datas." Style="{StaticResource Subtitulo}" HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </Border>
      </CollectionView.EmptyView>

      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="vm:LancamentoVm">
          <Border Style="{StaticResource LinhaLista}"
                            Margin="0,0,0,6"
                            BackgroundColor="{Binding CorFundoDestaque}">

            <!-- duplo clique: mostra/esconde os totais da série -->
            <Border.GestureRecognizers>
              <TapGestureRecognizer NumberOfTapsRequired="2"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExtratoViewModel}}, Path=AlternarTotaisCommand}"
                                    CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="0">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0" Padding="0">
                <Border WidthRequest="56"
                      HeightRequest="55"
                      BackgroundColor="{StaticResource SuperficieElevada}"
                      StrokeThickness="0"
                      StrokeShape="RoundRectangle 8,0,8,0"
                      VerticalOptions="Center">
                  <Label Text="{Binding IconeCentro}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Grid Grid.Column="1" ColumnDefinitions="*">
                  <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="{Binding Descricao}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{Binding CorPendente}" />

                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                      <VerticalStackLayout Spacing="1" VerticalOptions="End">
                        <Label Text="{Binding Detalhe}" Style="{StaticResource Subtitulo}" FontSize="11" />
                        <Label Text="{Binding ContaDescricao}" FontSize="10" TextColor="{StaticResource TextoFraco}" />
                      </VerticalStackLayout>

                      <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="End">
                        <Label Text="{Binding ValorTexto}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{Binding CorValor}"
                                       HorizontalTextAlignment="End" />
                        <Label Text="{Binding SaldoTexto}"
                                       FontSize="11"
                                       TextColor="{Binding CorSaldo}"
                                       IsVisible="{Binding TemSaldo}"
                                       HorizontalTextAlignment="End" />
                      </VerticalStackLayout>

                      <Button Grid.Column="2"
                                    Text="Σ"
                                    IsVisible="{Binding PodeExpandir}"
                                    Style="{StaticResource BotaoTexto}"
                                    FontSize="13"
                                    SemanticProperties.Description="Ver totais da série"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExtratoViewModel}}, Path=AlternarTotaisCommand}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End" />

                      <Button Grid.Column="3"
                                    Text="✓"
                                    IsVisible="{Binding Pendente}"
                                    Style="{StaticResource BotaoTexto}"
                                    FontSize="11"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExtratoViewModel}}, Path=CompensarCommand}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End" />
                    </Grid>
                  </VerticalStackLayout>
                </Grid>
              </Grid>

              <!-- totais da série (duplo clique na linha) -->
              <VerticalStackLayout IsVisible="{Binding TotaisVisiveis}" Spacing="4" Margin="68,8,0,2">
                <BoxView Style="{StaticResource Separador}" />

                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="Total pago" Style="{StaticResource Subtitulo}" FontSize="11" />
                  <Label Grid.Column="1" Text="{Binding PagoTexto}" FontSize="11" TextColor="{StaticResource TextoSecundario}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="Total à pagar" Style="{StaticResource Subtitulo}" FontSize="11" />
                  <Label Grid.Column="1" Text="{Binding APagarTexto}" FontSize="11" TextColor="{StaticResource TextoSecundario}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="Total geral" Style="{StaticResource Subtitulo}" FontSize="11" />
                  <Label Grid.Column="1" Text="{Binding TotalSerieTexto}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource Texto}" />
                </Grid>
              </VerticalStackLayout>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <!-- carregando: o cálculo do período passa por todo o histórico da conta -->
    <Grid Grid.Row="2"
          IsVisible="{Binding MostrarCarregando}"
          BackgroundColor="#D905080F">
      <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
        <ActivityIndicator IsRunning="{Binding MostrarCarregando}"
                           IsVisible="{Binding MostrarCarregando}"
                           Color="{StaticResource Primaria}"
                           HeightRequest="34"
                           WidthRequest="34" />
        <Label Text="Carregando extrato…" Style="{StaticResource Subtitulo}" />
      </VerticalStackLayout>
    </Grid>

    <!-- ===================== painel de seleção de contas ===================== -->
    <Grid Grid.RowSpan="2"
                  IsVisible="{Binding SelecaoContasAtiva}"
                  BackgroundColor="#CC05080F"
                  Padding="24">

      <Border Style="{StaticResource CardElevado}"
                        Padding="0"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        MaximumWidthRequest="560">

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

          <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="4">
            <Label Text="{Binding SelecaoContas.Titulo}" Style="{StaticResource TituloSecao}" />
            <Label Text="{Binding SelecaoContas.Instrucao}"
                                   Style="{StaticResource Subtitulo}"
                                   FontSize="11" />
          </VerticalStackLayout>

          <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding SelecaoContas.Contas}"
                                        SelectionMode="None"
                                        MaximumHeightRequest="320"
                                        Margin="20,0">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="vm:ContaFiltro">
                <Border BackgroundColor="{StaticResource Superficie}"
                                            StrokeThickness="0"
                                            Padding="12"
                                            Margin="0,0,0,6"
                                            StrokeShape="RoundRectangle 10">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding Selecionada, Mode=TwoWay}"
                                                      VerticalOptions="Center"
                                                      Color="{StaticResource Primaria}" />

                    <Label Grid.Column="1"
                                                   Text="{Binding Rotulo}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <VerticalStackLayout Grid.Row="2" Padding="20,10,20,18" Spacing="10">
            <HorizontalStackLayout Spacing="12">
              <Button Text="Marcar todas"
                                        Command="{Binding SelecaoContas.MarcarTodasCommand}"
                                        Style="{StaticResource BotaoTexto}" />

              <Button Text="Limpar"
                                        Command="{Binding SelecaoContas.LimparCommand}"
                                        Style="{StaticResource BotaoTexto}" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Text="Cancelar"
                                        Command="{Binding SelecaoContas.CancelarCommand}"
                                        Style="{StaticResource BotaoSecundario}" />

              <Button Grid.Column="1"
                                        Text="{Binding SelecaoContas.TextoConfirmar}"
                                        Command="{Binding SelecaoContas.ConfirmarCommand}"
                                        IsEnabled="{Binding SelecaoContas.TemSelecao}" />
            </Grid>
          </VerticalStackLayout>
        </Grid>
      </Border>
    </Grid>
    <!-- ===================== painel de compensação ===================== -->
    <Grid Grid.RowSpan="2"
                  IsVisible="{Binding CompensacaoAtiva}"
                  BackgroundColor="#CC05080F"
                  Padding="24">

      <Border Style="{StaticResource CardElevado}"
                        Padding="0"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        MaximumWidthRequest="470">

        <VerticalStackLayout Padding="22,20" Spacing="14">

          <VerticalStackLayout Spacing="2">
            <Label Text="Compensar lançamento" Style="{StaticResource TituloSecao}" />
            <Label Text="{Binding Compensacao.Descricao}"
                                   Style="{StaticResource Subtitulo}"
                                   FontSize="12" />
          </VerticalStackLayout>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="VALOR" Style="{StaticResource Rotulo}" VerticalOptions="Center" />
            <Label Grid.Column="1"
                                   Text="{Binding Compensacao.ValorTexto}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   VerticalOptions="Center" />
          </Grid>

          <VerticalStackLayout Spacing="6">
            <Label Text="DATA DA COMPENSAÇÃO" Style="{StaticResource Rotulo}" />

            <Border Style="{StaticResource Campo}">
              <DatePicker Date="{Binding Compensacao.Data}" Format="dd/MM/yyyy" />
            </Border>

            <Label Text="{Binding Compensacao.VencimentoTexto}"
                                   Style="{StaticResource Subtitulo}"
                                   FontSize="11" />
          </VerticalStackLayout>

          <HorizontalStackLayout Spacing="10">
            <Button Text="{Binding Compensacao.RotuloHoje}"
                                    Command="{Binding Compensacao.HojeCommand}"
                                    Style="{StaticResource BotaoTexto}"
                                    FontSize="11" />

            <Button Text="Usar o vencimento"
                                    Command="{Binding Compensacao.ManterVencimentoCommand}"
                                    Style="{StaticResource BotaoTexto}"
                                    FontSize="11" />
          </HorizontalStackLayout>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Cancelar"
                                    Command="{Binding Compensacao.CancelarCommand}"
                                    Style="{StaticResource BotaoSecundario}" />

            <Button Grid.Column="1"
                                    Text="Confirmar"
                                    Command="{Binding Compensacao.ConfirmarCommand}" />
          </Grid>
        </VerticalStackLayout>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
