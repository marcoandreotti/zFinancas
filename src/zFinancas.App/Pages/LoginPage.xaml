<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:zFinancas.App.ViewModels"
             x:Class="zFinancas.App.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Background="{StaticResource GradienteFundo}">

  <Grid ColumnDefinitions="*, Auto">
    <!-- brilho decorativo no topo -->
    <Border WidthRequest="680"
                HeightRequest="780"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                TranslationY="-150"
                StrokeThickness="10"
                Opacity="0.35"
                BackgroundColor="{StaticResource Primaria}"
                StrokeShape="RoundRectangle 0 0 120 120" />

    <ScrollView>
      <Grid Padding="24,40,24,28" RowDefinitions="*,Auto">

        <VerticalStackLayout Grid.Row="0"
                                     MaximumWidthRequest="440"
                                     Spacing="20"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

          <!-- marca -->
          <Image Source="simbolo.png"
                           WidthRequest="164"
                           HeightRequest="164"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

          <VerticalStackLayout Spacing="6">
            <Image Source="logotipoclaro.png"
                               HeightRequest="36"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />

            <Label Text="{Binding Subtitulo}"
                               Style="{StaticResource Subtitulo}"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
          </VerticalStackLayout>

          <!-- cartão de entrada -->
          <Border Style="{StaticResource CardElevado}">
            <VerticalStackLayout Spacing="14">

              <Label Text="USUÁRIO" Style="{StaticResource Rotulo}" />

              <Border>
                <Picker Title="Selecione o usuário"
                                        ItemsSource="{Binding Usuarios}"
                                        ItemDisplayBinding="{Binding Nome}"
                                        SelectedItem="{Binding UsuarioSelecionado}" />
              </Border>

              <Label Text="SENHA" Style="{StaticResource Rotulo}" Margin="0,4,0,0" />

              <Border>
                <Grid ColumnDefinitions="*,Auto">
                  <Entry x:Name="CampoSenha"
                                           Text="{Binding Senha}"
                                           IsPassword="{Binding SenhaMascarada}"
                                           Placeholder="Digite sua senha"
                                           ReturnType="Go"
                                           ReturnCommand="{Binding EntrarCommand}" />
                  <Button Grid.Column="1"
                                            Text="👁"
                                            Command="{Binding AlternarSenhaCommand}"
                                            Style="{StaticResource BotaoTexto}"
                                            FontSize="16"
                                            VerticalOptions="Center" />
                </Grid>
              </Border>

              <Label Text="{Binding DicaSenha, StringFormat='Dica: {0}'}"
                                   IsVisible="{Binding MostrarDica}"
                                   Style="{StaticResource Subtitulo}" />

              <Label Text="{Binding Mensagem}"
                                   IsVisible="{Binding Mensagem, Converter={StaticResource TextoPreenchido}}"
                                   TextColor="{StaticResource Negativo}"
                                   FontSize="13" />

              <ActivityIndicator IsRunning="{Binding Ocupado}"
                                               IsVisible="{Binding Ocupado}"
                                               HeightRequest="22" />

              <Button Text="Entrar"
                      Command="{Binding EntrarCommand}"
                      Margin="0,6,0,0" />

              <Button Text="Entrar com biometria"
                                    Command="{Binding BiometriaCommand}"
                                    IsVisible="{Binding MostrarBiometria}"
                                    Style="{StaticResource BotaoSecundario}" />
            </VerticalStackLayout>
          </Border>

          <!-- ações secundárias -->
          <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
            <Button Text="Esqueci a senha"
                                Command="{Binding RecuperarSenhaCommand}"
                                Style="{StaticResource BotaoTexto}" />
            <Label Text="•" TextColor="{StaticResource TextoFraco}" VerticalOptions="Center" />
            <Button Text="Primeiro acesso"
                                Command="{Binding PrimeiroAcessoCommand}"
                                Style="{StaticResource BotaoTexto}" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </Grid>
    </ScrollView>
  </Grid>
</ContentPage>
