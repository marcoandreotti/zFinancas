<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:zFinancas.App.ViewModels"
             x:Class="zFinancas.App.Pages.LancamentoEdicaoPage"
             x:DataType="vm:LancamentoEdicaoViewModel"
             Title="{Binding Titulo}"
             Background="{StaticResource GradienteFundo}">

    <ScrollView>
        <VerticalStackLayout Padding="24,18,24,32" Spacing="16" MaximumWidthRequest="720">

            <!-- ===================== voz -->
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                    <Label Text="🎤" FontSize="18" VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="{Binding RotuloFalar}"
                            Command="{Binding FalarCommand}"
                            IsEnabled="{Binding NaoOcupado}"
                            Style="{StaticResource BotaoSecundario}" />

                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                        <Label Text="Dite o lançamento" Style="{StaticResource Rotulo}" />
                        <Label Text="{Binding StatusVoz}"
                               IsVisible="{Binding TemStatusVoz}"
                               Style="{StaticResource Subtitulo}"
                               FontSize="11" />
                        <Label Text="Ex.: “gastei 32,50 no mercado ontem”"
                               IsVisible="{Binding TemStatusVoz, Converter={StaticResource InverterBooleano}}"
                               Style="{StaticResource Subtitulo}"
                               FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ===================== tipo -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="-  Despesa"
                        Command="{Binding DespesaCommand}"
                        BackgroundColor="{Binding EhDespesa, Converter={StaticResource BooleanoParaCor}, ConverterParameter='#FF5C7A|#16203A'}" />
                <Button Grid.Column="1"
                        Text="+  Recebimento"
                        Command="{Binding RecebimentoCommand}"
                        BackgroundColor="{Binding EhRecebimento, Converter={StaticResource BooleanoParaCor}, ConverterParameter='#2ED3A0|#16203A'}" />
            </Grid>

            <!-- ===================== dados -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="DESCRIÇÃO" Style="{StaticResource Rotulo}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding Descricao}"
                               Placeholder="Ex.: Mercado, Pix recebido, Aluguel"
                               MaxLength="50" />
                    </Border>

                    <Label Text="VALOR" Style="{StaticResource Rotulo}" Margin="0,4,0,0" />
                    <Border Style="{StaticResource Campo}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="R$"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource TextoSecundario}"
                                   Margin="2,0,8,0" />
                            <Entry Grid.Column="1"
                                   Text="{Binding ValorTexto}"
                                   Keyboard="Numeric"
                                   Placeholder="0,00"
                                   FontSize="20"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{Binding CorTipo}" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CONTA CORRENTE" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <Picker ItemsSource="{Binding Contas}"
                                        ItemDisplayBinding="{Binding Descricao}"
                                        SelectedItem="{Binding ContaSelecionada}"
                                        Title="Selecione" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="CENTRO DE CUSTO" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <Picker ItemsSource="{Binding Centros}"
                                        ItemDisplayBinding="{Binding Descricao}"
                                        SelectedItem="{Binding CentroSelecionado}"
                                        Title="Selecione" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="VENCIMENTO" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <DatePicker Date="{Binding DataVencimento}" Format="dd/MM/yyyy" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="DATA DO LANÇAMENTO" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <DatePicker Date="{Binding DataLancamento}" Format="dd/MM/yyyy" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ===================== recorrência -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="REPETIÇÃO" Style="{StaticResource Rotulo}" />

                    <Border Style="{StaticResource Campo}">
                        <Picker ItemsSource="{Binding Recorrencias}"
                                ItemDisplayBinding="{Binding Descricao}"
                                SelectedItem="{Binding RecorrenciaSelecionada}" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding PermiteParcelas}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="QUANTIDADE DE PARCELAS" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry Text="{Binding QuantidadeParcelas}" Keyboard="Numeric" Placeholder="12" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="parcelas"
                               Style="{StaticResource Subtitulo}"
                               VerticalOptions="End"
                               Margin="0,0,0,14" />
                    </Grid>

                    <Label Text="{Binding ResumoParcelas}" Style="{StaticResource Subtitulo}" />

                    <BoxView Style="{StaticResource Separador}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Já COMPENSADO" Style="{StaticResource Rotulo}" />
                            <Label Text="Marcar como pago/recebido" Style="{StaticResource Subtitulo}" FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding Compensado}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding MostraDataCompensacao}">
                        <Label Text="DATA DA COMPENSAÇÃO" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource Campo}">
                            <DatePicker Date="{Binding DataCompensado}" Format="dd/MM/yyyy" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="OBSERVAÇÃO (OPCIONAL)" Style="{StaticResource Rotulo}" Margin="0,4,0,0" />
                    <Border Style="{StaticResource Campo}" Padding="12,8">
                        <Editor Text="{Binding Observacao}" AutoSize="TextChanges" HeightRequest="70" MaxLength="200" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ===================== ações -->
            <Button Text="Salvar lançamento" Command="{Binding SalvarCommand}" IsEnabled="{Binding NaoOcupado}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{Binding TextoCompensacao}"
                        Command="{Binding CompensarCommand}"
                        IsVisible="{Binding PodeExcluir}"
                        Style="{StaticResource BotaoSecundario}" />

                <Button Grid.Column="1"
                        Text="Quitar parcelas pendentes"
                        Command="{Binding QuitarCommand}"
                        IsVisible="{Binding PodeQuitar}"
                        Style="{StaticResource BotaoSecundario}" />
            </Grid>

            <Button Text="Excluir lançamento"
                    Command="{Binding ExcluirCommand}"
                    IsVisible="{Binding PodeExcluir}"
                    Style="{StaticResource BotaoPerigo}" />

            <Button Text="Cancelar"
                    Command="{Binding CancelarCommand}"
                    Style="{StaticResource BotaoTexto}"
                    HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" HeightRequest="22" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
