<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:zFinancas.App.Conversores"
             x:Class="zFinancas.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:TextoPreenchidoConverter x:Key="TextoPreenchido" />
      <conv:InverterBooleanoConverter x:Key="InverterBooleano" />
      <conv:ValorParaCorConverter x:Key="ValorParaCor" />
      <conv:BooleanoParaOpacidadeConverter x:Key="BooleanoParaOpacidade" />
      <conv:BooleanoParaCorConverter x:Key="BooleanoParaCor" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
