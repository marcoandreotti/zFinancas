# Normaliza o fim de linha no índice e respeita o padrão de cada sistema
* text=auto

# Fontes e scripts do app usam CRLF no Windows
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Binários
*.png binary
*.jpg binary
*.ttf binary
*.ico binary
*.svg text eol=lf